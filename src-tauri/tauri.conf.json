{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sucky Cache Cleaner",
  "version": "0.1.0",
  "identifier": "com.ramenagii.suckycachecleaner",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sucky — Cache Cleaner",
        "width": 1280,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true,
        "backgroundColor": "#EDEDE7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
